# MAIA 2.0 — copia in .env soltanto se devi personalizzare la configurazione
MAIA_SIM_INTERVAL=60
MAIA_SESSION_HOURS=8
MAIA_WATER_THRESHOLD=0.9
MAIA_GAS_THRESHOLD=5.0
# MAIA_DB=/percorso/maia-v2.db
# MAIA_DATABASE_URL=postgresql+psycopg://utente:password@host:5432/maia
# Opzionali (non necessari per avvio standard):
# MAIA_MQTT_HOST=broker
# MAIA_MQTT_USER=maia
# MAIA_MQTT_PASSWORD=...
# MAIA_MQTT_KEY=...  # chiave casuale >=32 caratteri
# MAIA_PG_PASSWORD=...  # password alfanumerica per compose.postgres.yaml
# MAIA_VAPID_PUBLIC=...
# MAIA_VAPID_PRIVATE_FILE=/percorso/chiave.pem
# MAIA_VAPID_SUBJECT=mailto:contatto@example.test
